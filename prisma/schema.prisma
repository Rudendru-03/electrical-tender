generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadType {
  TENDER
  QUOTE
  SITE_VISIT
  CALLBACK
  CONTACT
  CAREER
}

enum ClientType {
  GOVERNMENT
  PRIVATE
  BUILDER
  AMC
  OTHER
}

enum LeadStatus {
  NEW
  IN_REVIEW
  QUOTED
  WON
  LOST
  CLOSED
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  PHONE
  EMAIL
  SOCIAL
  LISTING
  REFERRAL
  OTHER
}

enum Role {
  ADMIN
  SALES
  CONTENT
}

model Lead {
  id             String      @id @default(cuid())
  reference      String      @unique
  type           LeadType
  status         LeadStatus  @default(NEW)
  source         LeadSource  @default(WEBSITE)
  clientType     ClientType?
  name           String
  organisation   String?
  email          String?
  phone          String
  city           String?
  state          String?
  workType       String?
  estimatedValue String?
  deadline       DateTime?
  preferredAt    DateTime?
  position       String?
  message        String?
  locale         String      @default("en")
  pagePath       String?
  assignedTo     AdminUser?  @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId   String?
  files          LeadFile[]
  notes          LeadNote[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([type, createdAt])
}

model LeadFile {
  id        String   @id @default(cuid())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  name      String
  key       String
  mime      String
  size      Int
  createdAt DateTime @default(now())

  @@index([leadId])
}

model LeadNote {
  id        String     @id @default(cuid())
  lead      Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  author    AdminUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId  String?
  body      String
  createdAt DateTime   @default(now())

  @@index([leadId])
}

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         Role       @default(SALES)
  active       Boolean    @default(true)
  leads        Lead[]
  notes        LeadNote[]
  createdAt    DateTime   @default(now())
}

model Service {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  summary   String
  body      String   @default("")
  icon      String   @default("zap")
  features  String[]
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  client    String
  sector    String
  service   String?
  location  String
  value     String?
  year      Int?
  duration  String?
  summary   String
  body      String   @default("")
  images    String[]
  featured  Boolean  @default(false)
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id           String   @id @default(cuid())
  name         String
  designation  String?
  organisation String
  quote        String
  logo         String?
  order        Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Credential {
  id        String    @id @default(cuid())
  title     String
  category  String
  issuer    String?
  number    String?
  validTill DateTime?
  document  String?
  order     Int       @default(0)
  published Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  body        String
  cover       String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model JobOpening {
  id          String   @id @default(cuid())
  title       String
  location    String
  type        String   @default("Full-time")
  experience  String?
  description String
  open        Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}
