# ---------- Database ----------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/electrical_site?schema=public"
# Max DB connections per server process (empty = driver default of 10)
DB_POOL_MAX=""

# ---------- Site identity ----------
SITE_URL="http://localhost:3000"
SITE_NAME="Your Company Electricals"
SITE_LEGAL_NAME="Your Company Electricals Pvt. Ltd."
SITE_ESTABLISHED_YEAR=""

# ---------- Contact channels ----------
SITE_PHONE="+91 00000 00000"
SITE_PHONE_ALT=""
# WhatsApp number in international format, digits only (e.g. 919876543210)
SITE_WHATSAPP=""
MAIL_SALES="sales@example.com"
MAIL_TENDERS="tenders@example.com"
MAIL_CAREERS="careers@example.com"
SITE_ADDRESS="Office address, City, State - PIN"
SITE_HOURS="Mon-Sat, 9:30 AM - 6:30 PM"
GOOGLE_MAPS_EMBED_URL=""

# ---------- Social / listings (leave empty to hide) ----------
SOCIAL_LINKEDIN=""
SOCIAL_FACEBOOK=""
SOCIAL_INSTAGRAM=""
SOCIAL_YOUTUBE=""
LISTING_GOOGLE_BUSINESS=""
LISTING_INDIAMART=""
LISTING_TRADEINDIA=""
LISTING_JUSTDIAL=""

# ---------- Channel toggles ----------
ENABLE_WHATSAPP="true"
ENABLE_CALL="true"
# Live chat: set ENABLE_CHAT=true and the widget script URL (e.g. Tawk.to / Crisp embed src)
ENABLE_CHAT="false"
CHAT_WIDGET_SRC=""

# ---------- Home page stats (leave empty to hide a stat) ----------
STAT_YEARS=""
STAT_PROJECTS=""
STAT_CLIENTS=""
STAT_CAPACITY=""

# ---------- Tender scope shown on /tenders ----------
TENDER_VALUE_RANGE=""
TENDER_REGIONS=""

# ---------- Lead forms ----------
LEAD_REF_PREFIX="ET"
UPLOAD_DIR="./storage"
UPLOAD_MAX_FILES="5"
UPLOAD_MAX_SIZE_MB="15"
UPLOAD_ALLOWED_EXT="pdf,doc,docx,xls,xlsx,csv,dwg,dxf,zip,jpg,jpeg,png"
LEAD_RATE_LIMIT_MAX="5"
LEAD_RATE_LIMIT_WINDOW_MIN="10"
# Cloudflare Turnstile captcha (both keys needed; leave empty to disable)
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---------- Email (leave SMTP_HOST empty to log emails to the console) ----------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Website <no-reply@example.com>"

# ---------- Admin ----------
# openssl rand -base64 32
SESSION_SECRET=""
SESSION_DAYS="7"
# Time zone used to show dates in the admin panel
ADMIN_TIMEZONE="Asia/Kolkata"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# ---------- Analytics ----------
GA_MEASUREMENT_ID=""
